<routes>
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" 
           length="5" maxSpeed="50" color="yellow"/>

    <!-- ORA DI PUNTA (0-500s) -->
    <!-- Nord → Sud -->
    <flow id="nord_sud_peak" type="car"
          from="nord_in3" to="sud_out4"
          begin="0" end="500"
          probability="0.4"/>

    <!-- Sud → Nord -->
    <flow id="sud_nord_peak" type="car"
          from="sud_in4" to="nord_out3"
          begin="0" end="500"
          probability="0.4"/>

    <!-- Est → Ovest -->
    <flow id="est_ovest_peak" type="car"
          from="est_in" to="ovest_out"
          begin="0" end="500"
          probability="0.3"/>

    <!-- Ovest → Est -->
    <flow id="ovest_est_peak" type="car"
          from="ovest_in" to="est_out"
          begin="0" end="500"
          probability="0.3"/>

    <!-- Svolte ora di punta -->
    <flow id="nord_est_peak" type="car"
          from="nord_in3" to="est_out"
          begin="0" end="500"
          probability="0.1"/>

    <flow id="nord_ovest_peak" type="car"
          from="nord_in3" to="ovest_out"
          begin="0" end="500"
          probability="0.1"/>

    <flow id="sud_est_peak" type="car"
          from="sud_in4" to="est_out"
          begin="0" end="500"
          probability="0.1"/>

    <flow id="sud_ovest_peak" type="car"
          from="sud_in4" to="ovest_out"
          begin="0" end="500"
          probability="0.1"/>

    <!-- TRAFFICO NORMALE (500-1000s) -->
    <flow id="nord_sud_normal" type="car"
          from="nord_in3" to="sud_out4"
          begin="500" end="1000"
          probability="0.2"/>

    <flow id="sud_nord_normal" type="car"
          from="sud_in4" to="nord_out3"
          begin="500" end="1000"
          probability="0.2"/>

    <flow id="est_ovest_normal" type="car"
          from="est_in" to="ovest_out"
          begin="500" end="1000"
          probability="0.15"/>

    <flow id="ovest_est_normal" type="car"
          from="ovest_in" to="est_out"
          begin="500" end="1000"
          probability="0.15"/>

</routes>
